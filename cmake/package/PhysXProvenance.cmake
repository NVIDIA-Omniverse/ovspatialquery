# Custom builds must not claim the pinned package's identity in installed artifacts.
set(OVSPATIALQUERY_PHYSX_LICENSE_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/third_party/physx/LICENSE")
set(OVSPATIALQUERY_PHYSX_PROVENANCE_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/deps/physx-license-provenance.json")
if(OVSPATIALQUERY_CUSTOM_PHYSX)
    set(_physx_license "${PHYSX_SDK_DIR}/PACKAGE-LICENSES/physxsdk-LICENSE.md")
    if(NOT EXISTS "${_physx_license}")
        set(_physx_license "${PHYSX_SDK_DIR}/documentation/license/PACKAGE-LICENSES/LICENSE.md")
    endif()
    if(NOT EXISTS "${_physx_license}")
        set(_physx_license "${PHYSX_SDK_DIR}/LICENSE.md")
    endif()
    if(NOT EXISTS "${_physx_license}")
        message(FATAL_ERROR "Custom PhysX SDK is missing PACKAGE-LICENSES/physxsdk-LICENSE.md (or documentation/license/PACKAGE-LICENSES/LICENSE.md)")
    endif()
    file(SHA256 "${_physx_license}" _physx_license_hash)
    file(READ "${_physx_license}" _physx_license_text)
    file(READ "${OVSPATIALQUERY_PHYSX_LICENSE_SOURCE}" _physx_expected_license_text)
    string(REPLACE "\r\n" "\n" _physx_license_text "${_physx_license_text}")
    string(REPLACE "\r\n" "\n" _physx_expected_license_text "${_physx_expected_license_text}")
    if(NOT _physx_license_text STREQUAL _physx_expected_license_text)
        message(FATAL_ERROR "Custom PhysX license differs from the supported Apache-2.0 notice; review packaging notices before using this SDK")
    endif()
    file(READ "${PHYSX_SDK_DIR}/include/foundation/PxPhysicsVersion.h" _physx_header)
    foreach(_part MAJOR MINOR BUGFIX)
        string(REGEX MATCH "#define[ \t]+PX_PHYSICS_VERSION_${_part}[ \t]+([0-9]+)" _match "${_physx_header}")
        if(NOT _match)
            message(FATAL_ERROR "Custom PhysX SDK has no PX_PHYSICS_VERSION_${_part}")
        endif()
        set(_physx_${_part} "${CMAKE_MATCH_1}")
    endforeach()
    file(SHA256 "${PHYSX_SDK_DIR}/include/foundation/PxPhysicsVersion.h" _physx_header_hash)
    file(SIZE "${_physx_license}" _physx_license_size)
    set(_physx_record "{}")
    string(JSON _physx_record SET "${_physx_record}" schema_version 1)
    string(JSON _physx_record SET "${_physx_record}" component "\"NVIDIA PhysX SDK\"")
    string(JSON _physx_record SET "${_physx_record}" package "\"custom-physxsdk@${_physx_MAJOR}.${_physx_MINOR}.${_physx_BUGFIX}\"")
    string(JSON _physx_record SET "${_physx_record}" version_header_sha256 "\"${_physx_header_hash}\"")
    string(JSON _physx_record SET "${_physx_record}" license_expression "\"Apache-2.0\"")
    string(JSON _physx_record SET "${_physx_record}" installed_license "\"physx-LICENSE.md\"")
    string(JSON _physx_record SET "${_physx_record}" installed_license_sha256 "\"${_physx_license_hash}\"")
    string(JSON _physx_record SET "${_physx_record}" installed_license_size ${_physx_license_size})
    string(JSON _physx_record SET "${_physx_record}" static_linked true)
    string(JSON _physx_record SET "${_physx_record}" files "{}")
    file(GLOB_RECURSE _physx_libraries RELATIVE "${PHYSX_SDK_DIR}"
        "${PHYSX_SDK_DIR}/bin/${PHYSX_PLATFORM_BIN}/*.a"
        "${PHYSX_SDK_DIR}/bin/${PHYSX_PLATFORM_BIN}/*.lib"
        "${PHYSX_SDK_DIR}/include/*")
    foreach(_library IN LISTS _physx_libraries)
        file(SHA256 "${PHYSX_SDK_DIR}/${_library}" _hash)
        string(JSON _physx_record SET "${_physx_record}" files "${_library}" "\"${_hash}\"")
    endforeach()
    set(OVSPATIALQUERY_PHYSX_LICENSE_SOURCE "${_physx_license}")
    set(OVSPATIALQUERY_PHYSX_PROVENANCE_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/physx-PROVENANCE.json")
    file(CONFIGURE OUTPUT "${OVSPATIALQUERY_PHYSX_PROVENANCE_SOURCE}"
        CONTENT "${_physx_record}\n" @ONLY)
    # Compile settings invalidate every generator, including host Visual Studio.
    string(SHA256 _physx_record_hash "${_physx_record}")
    target_compile_definitions(ovspatialquery PRIVATE
        "OVSPATIALQUERY_CUSTOM_PHYSX_PROVENANCE=${_physx_record_hash}")
    add_custom_command(TARGET ovspatialquery POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different
            "${OVSPATIALQUERY_PHYSX_PROVENANCE_SOURCE}"
            "${CMAKE_CURRENT_BINARY_DIR}/physx-built-$<CONFIG>.json"
        VERBATIM)
    # Check at install time as well: a direct CMake install does not reconfigure.
    set(_physx_install_check [[
        file(SHA256 "@OVSPATIALQUERY_PHYSX_PROVENANCE_SOURCE@" _configured)
        file(SHA256 "@CMAKE_CURRENT_BINARY_DIR@/physx-built-${CMAKE_INSTALL_CONFIG_NAME}.json" _built)
        if(NOT _configured STREQUAL _built)
            message(FATAL_ERROR "Custom PhysX SDK provenance changed since the library was linked; rebuild before installing")
        endif()
        file(READ "@OVSPATIALQUERY_PHYSX_PROVENANCE_SOURCE@" _record)
        string(JSON _count LENGTH "${_record}" files)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _path MEMBER "${_record}" files ${_index})
            string(JSON _expected GET "${_record}" files "${_path}")
            file(SHA256 "@PHYSX_SDK_DIR@/${_path}" _actual)
            if(NOT _actual STREQUAL _expected)
                message(FATAL_ERROR "Custom PhysX SDK changed since configuration: ${_path}; reconfigure and rebuild before installing")
            endif()
        endforeach()
        string(JSON _expected GET "${_record}" installed_license_sha256)
        file(SHA256 "@_physx_license@" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "Custom PhysX SDK license changed since configuration; reconfigure and rebuild before installing")
        endif()
    ]])
    string(CONFIGURE "${_physx_install_check}" _physx_install_check @ONLY)
    install(CODE "${_physx_install_check}")
endif()
set(OVSPATIALQUERY_PHYSX_LICENSE_SOURCE "${OVSPATIALQUERY_PHYSX_LICENSE_SOURCE}" CACHE INTERNAL "Selected PhysX license" FORCE)
set(OVSPATIALQUERY_PHYSX_PROVENANCE_SOURCE "${OVSPATIALQUERY_PHYSX_PROVENANCE_SOURCE}" CACHE INTERNAL "Selected PhysX provenance" FORCE)
