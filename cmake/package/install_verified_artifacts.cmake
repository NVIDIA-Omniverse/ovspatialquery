cmake_minimum_required(VERSION 3.24)

foreach(OVSPATIALQUERY_REQUIRED_VARIABLE
        OVSPATIALQUERY_BUILD_DIR
        OVSPATIALQUERY_BUILD_CONFIG
        OVSPATIALQUERY_EXPECT_OVSTAGE_COMPANION
        OVSPATIALQUERY_EXPECT_CUDA_BACKEND
        OVSPATIALQUERY_PYTHON_EXECUTABLE
        OVSPATIALQUERY_CTYPES_TEST
        OVSPATIALQUERY_LIBRARY_RELATIVE_PATH)
    if(NOT DEFINED ${OVSPATIALQUERY_REQUIRED_VARIABLE})
        message(FATAL_ERROR "${OVSPATIALQUERY_REQUIRED_VARIABLE} is required")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/install_root_guard.cmake")

file(REMOVE_RECURSE "${OVSPATIALQUERY_NORMALIZED_INSTALL_ROOT}")
if(EXISTS "${OVSPATIALQUERY_NORMALIZED_INSTALL_ROOT}")
    message(FATAL_ERROR
        "ovspatialquery could not clear the previous verified install: "
        "${OVSPATIALQUERY_NORMALIZED_INSTALL_ROOT}")
endif()

execute_process(
    COMMAND "${CMAKE_COMMAND}"
        "-DOVSPATIALQUERY_BUILD_DIR=${OVSPATIALQUERY_BUILD_DIR}"
        "-DOVSPATIALQUERY_BUILD_CONFIG=${OVSPATIALQUERY_BUILD_CONFIG}"
        "-DOVSPATIALQUERY_INSTALL_ROOT=${OVSPATIALQUERY_NORMALIZED_INSTALL_ROOT}"
        "-DOVSPATIALQUERY_ALLOWED_PARENT=${OVSPATIALQUERY_NORMALIZED_ALLOWED_PARENT}"
        "-DOVSPATIALQUERY_ALLOWED_LEAF=${OVSPATIALQUERY_ALLOWED_LEAF}"
        -P "${CMAKE_CURRENT_LIST_DIR}/install_artifacts.cmake"
    RESULT_VARIABLE OVSPATIALQUERY_STAGE_RESULT
    OUTPUT_VARIABLE OVSPATIALQUERY_STAGE_STDOUT
    ERROR_VARIABLE OVSPATIALQUERY_STAGE_STDERR)
if(NOT OVSPATIALQUERY_STAGE_RESULT EQUAL 0)
    message(FATAL_ERROR
        "ovspatialquery install failed: ${OVSPATIALQUERY_STAGE_RESULT}\n"
        "${OVSPATIALQUERY_STAGE_STDOUT}\n${OVSPATIALQUERY_STAGE_STDERR}")
endif()

execute_process(
    COMMAND "${CMAKE_COMMAND}"
        "-DOVSPATIALQUERY_INSTALL_ROOT=${OVSPATIALQUERY_NORMALIZED_INSTALL_ROOT}"
        "-DOVSPATIALQUERY_DUMPBIN=${OVSPATIALQUERY_DUMPBIN}"
        "-DOVSPATIALQUERY_NM=${OVSPATIALQUERY_NM}"
        "-DOVSPATIALQUERY_READELF=${OVSPATIALQUERY_READELF}"
        "-DOVSPATIALQUERY_OBJDUMP=${OVSPATIALQUERY_OBJDUMP}"
        "-DOVSPATIALQUERY_EXPECT_OVSTAGE_COMPANION=${OVSPATIALQUERY_EXPECT_OVSTAGE_COMPANION}"
        "-DOVSPATIALQUERY_EXPECT_CUDA_BACKEND=${OVSPATIALQUERY_EXPECT_CUDA_BACKEND}"
        "-DOVSPATIALQUERY_EXPECT_SOURCE_REVISION=${OVSPATIALQUERY_EXPECT_SOURCE_REVISION}"
        "-DOVSPATIALQUERY_PHYSX_SOURCE_PROVENANCE=${OVSPATIALQUERY_PHYSX_SOURCE_PROVENANCE}"
        -P "${CMAKE_CURRENT_LIST_DIR}/verify_install.cmake"
    RESULT_VARIABLE OVSPATIALQUERY_VERIFY_RESULT
    OUTPUT_VARIABLE OVSPATIALQUERY_VERIFY_STDOUT
    ERROR_VARIABLE OVSPATIALQUERY_VERIFY_STDERR)
if(NOT OVSPATIALQUERY_VERIFY_RESULT EQUAL 0)
    message(FATAL_ERROR
        "ovspatialquery install verification failed: ${OVSPATIALQUERY_VERIFY_RESULT}\n"
        "${OVSPATIALQUERY_VERIFY_STDOUT}\n${OVSPATIALQUERY_VERIFY_STDERR}")
endif()

execute_process(
    COMMAND "${OVSPATIALQUERY_PYTHON_EXECUTABLE}"
        "${CMAKE_CURRENT_LIST_DIR}/../../tools/bootstrap/consumer_content.py"
        verify "${OVSPATIALQUERY_NORMALIZED_INSTALL_ROOT}"
        --version "${OVSPATIALQUERY_VERSION}"
        --source-revision "${OVSPATIALQUERY_EXPECT_SOURCE_REVISION}"
    COMMAND_ERROR_IS_FATAL ANY)

execute_process(
    COMMAND "${OVSPATIALQUERY_PYTHON_EXECUTABLE}"
        "${OVSPATIALQUERY_CTYPES_TEST}"
        --dll "${OVSPATIALQUERY_NORMALIZED_INSTALL_ROOT}/${OVSPATIALQUERY_LIBRARY_RELATIVE_PATH}"
    RESULT_VARIABLE OVSPATIALQUERY_CTYPES_RESULT
    OUTPUT_VARIABLE OVSPATIALQUERY_CTYPES_STDOUT
    ERROR_VARIABLE OVSPATIALQUERY_CTYPES_STDERR)
if(NOT OVSPATIALQUERY_CTYPES_RESULT EQUAL 0)
    message(FATAL_ERROR
        "ovspatialquery ctypes verification failed: ${OVSPATIALQUERY_CTYPES_RESULT}\n"
        "${OVSPATIALQUERY_CTYPES_STDOUT}\n${OVSPATIALQUERY_CTYPES_STDERR}")
endif()

message(STATUS
    "Published verified ovspatialquery artifacts at "
    "${OVSPATIALQUERY_NORMALIZED_INSTALL_ROOT}")
message(STATUS "${OVSPATIALQUERY_VERIFY_STDOUT}")
message(STATUS "${OVSPATIALQUERY_CTYPES_STDOUT}")
