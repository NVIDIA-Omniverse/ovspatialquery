# Programs shown in the guide must fit its code column without scrolling, and read as prose:
# no column alignment, which pads short declarations out to the longest type name.
BasedOnStyle: InheritParentConfig
ColumnLimit: 90
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
