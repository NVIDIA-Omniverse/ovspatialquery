cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/prepare_nested_build.cmake")

foreach(OVSPATIALQUERY_REQUIRED_VARIABLE
        OVSPATIALQUERY_SOURCE_DIR
        OVSPATIALQUERY_BUILD_ROOT
        OVSPATIALQUERY_TARGET_DEPS
        OVSPATIALQUERY_BUILD_CONFIG
        OVSPATIALQUERY_VERSION
        OVSPATIALQUERY_SOURCE_REVISION
        OVSPATIALQUERY_CTEST_COMMAND
        OVSPATIALQUERY_GENERATOR
        OVSPATIALQUERY_PYTHON_EXECUTABLE
        OVSPATIALQUERY_C_FLAGS
        OVSPATIALQUERY_CXX_FLAGS
        OVSPATIALQUERY_C_FLAGS_CONFIG
        OVSPATIALQUERY_CXX_FLAGS_CONFIG)
    if(NOT DEFINED ${OVSPATIALQUERY_REQUIRED_VARIABLE})
        message(FATAL_ERROR "${OVSPATIALQUERY_REQUIRED_VARIABLE} is required")
    endif()
endforeach()
string(TOUPPER "${OVSPATIALQUERY_BUILD_CONFIG}"
    OVSPATIALQUERY_BUILD_CONFIG_UPPER)

set(OVSPATIALQUERY_CORE_BUILD "${OVSPATIALQUERY_BUILD_ROOT}/product")
set(OVSPATIALQUERY_CORE_INSTALL "${OVSPATIALQUERY_BUILD_ROOT}/install")
set(OVSPATIALQUERY_CONSUMER_BUILD "${OVSPATIALQUERY_BUILD_ROOT}/consumer")
# A transferred fixture keeps the producer's compilers in its cached configure.
if(OVSPATIALQUERY_PREBUILT_CORE_INDEPENDENCE)
    ovspatialquery_nested_generator_args(OVSPATIALQUERY_GENERATOR_ARGS OFF)
else()
    ovspatialquery_nested_generator_args(OVSPATIALQUERY_GENERATOR_ARGS ON)
endif()

if(NOT OVSPATIALQUERY_PREBUILT_CORE_INDEPENDENCE)
    ovspatialquery_prepare_nested_build("${OVSPATIALQUERY_CORE_BUILD}"
        "${OVSPATIALQUERY_GENERATOR}")
    execute_process(
        COMMAND "${CMAKE_COMMAND}"
            -S "${OVSPATIALQUERY_SOURCE_DIR}"
            -B "${OVSPATIALQUERY_CORE_BUILD}"
            ${OVSPATIALQUERY_GENERATOR_ARGS}
            "-DCMAKE_BUILD_TYPE=${OVSPATIALQUERY_BUILD_CONFIG}"
            "-DCMAKE_C_FLAGS=${OVSPATIALQUERY_C_FLAGS}"
            "-DCMAKE_CXX_FLAGS=${OVSPATIALQUERY_CXX_FLAGS}"
            "-DCMAKE_C_FLAGS_${OVSPATIALQUERY_BUILD_CONFIG_UPPER}=${OVSPATIALQUERY_C_FLAGS_CONFIG}"
            "-DCMAKE_CXX_FLAGS_${OVSPATIALQUERY_BUILD_CONFIG_UPPER}=${OVSPATIALQUERY_CXX_FLAGS_CONFIG}"
            "-DOVSPATIALQUERY_VERSION=${OVSPATIALQUERY_VERSION}"
            "-DOVSPATIALQUERY_SOURCE_REVISION=${OVSPATIALQUERY_SOURCE_REVISION}"
            -DOVSPATIALQUERY_BUILD_PRODUCT=ON
            -DOVSPATIALQUERY_BUILD_TESTS=OFF
            -DOVSPATIALQUERY_BUILD_OVSTAGE_COMPANION=OFF
            "-DOVSPATIALQUERY_OVSTAGE_SDK_DIR=${OVSPATIALQUERY_BUILD_ROOT}/must-not-exist-ovstage-sdk"
            "-DOVSPATIALQUERY_PYTHON_EXECUTABLE=${OVSPATIALQUERY_PYTHON_EXECUTABLE}"
            -DOVSPATIALQUERY_FETCH_DEPS=OFF
            "-DOVSPATIALQUERY_TARGET_DEPS=${OVSPATIALQUERY_TARGET_DEPS}"
            "-DOVSPATIALQUERY_PHYSX_SDK_DIR=${OVSPATIALQUERY_PHYSX_SDK_DIR}"
        RESULT_VARIABLE OVSPATIALQUERY_CONFIGURE_RESULT)
    if(NOT OVSPATIALQUERY_CONFIGURE_RESULT EQUAL 0)
        message(FATAL_ERROR "Core-only configure failed: ${OVSPATIALQUERY_CONFIGURE_RESULT}")
    endif()
    execute_process(
        COMMAND "${CMAKE_COMMAND}" --build "${OVSPATIALQUERY_CORE_BUILD}"
            --config "${OVSPATIALQUERY_BUILD_CONFIG}" --target ovspatialquery
        RESULT_VARIABLE OVSPATIALQUERY_BUILD_RESULT)
    if(NOT OVSPATIALQUERY_BUILD_RESULT EQUAL 0)
        message(FATAL_ERROR "Core-only build failed: ${OVSPATIALQUERY_BUILD_RESULT}")
    endif()
    execute_process(
        COMMAND "${CMAKE_COMMAND}" --install "${OVSPATIALQUERY_CORE_BUILD}"
            --config "${OVSPATIALQUERY_BUILD_CONFIG}"
            --prefix "${OVSPATIALQUERY_CORE_INSTALL}"
        RESULT_VARIABLE OVSPATIALQUERY_INSTALL_RESULT)
    if(NOT OVSPATIALQUERY_INSTALL_RESULT EQUAL 0)
        message(FATAL_ERROR "Core-only install failed: ${OVSPATIALQUERY_INSTALL_RESULT}")
    endif()

endif()

set(OVSPATIALQUERY_VERIFY_COMMAND
    "${CMAKE_COMMAND}"
    "-DOVSPATIALQUERY_INSTALL_ROOT=${OVSPATIALQUERY_CORE_INSTALL}"
    -DOVSPATIALQUERY_EXPECT_OVSTAGE_COMPANION=OFF
    "-DOVSPATIALQUERY_EXPECT_SOURCE_REVISION=${OVSPATIALQUERY_SOURCE_REVISION}")
# Forward whichever binary inspectors the configuring tree named (dumpbin on
# Windows, nm plus readelf or objdump elsewhere).
foreach(OVSPATIALQUERY_INSPECTOR IN ITEMS
        OVSPATIALQUERY_DUMPBIN OVSPATIALQUERY_NM OVSPATIALQUERY_READELF OVSPATIALQUERY_OBJDUMP)
    if(DEFINED ${OVSPATIALQUERY_INSPECTOR})
        list(APPEND OVSPATIALQUERY_VERIFY_COMMAND
            "-D${OVSPATIALQUERY_INSPECTOR}=${${OVSPATIALQUERY_INSPECTOR}}")
    endif()
endforeach()
if(OVSPATIALQUERY_PHYSX_SDK_DIR)
    list(APPEND OVSPATIALQUERY_VERIFY_COMMAND
        "-DOVSPATIALQUERY_PHYSX_SOURCE_PROVENANCE=${OVSPATIALQUERY_CORE_BUILD}/physx-PROVENANCE.json")
endif()
list(APPEND OVSPATIALQUERY_VERIFY_COMMAND
    -P "${OVSPATIALQUERY_SOURCE_DIR}/cmake/package/verify_install.cmake")
execute_process(
    COMMAND ${OVSPATIALQUERY_VERIFY_COMMAND}
    RESULT_VARIABLE OVSPATIALQUERY_VERIFY_RESULT)
if(NOT OVSPATIALQUERY_VERIFY_RESULT EQUAL 0)
    message(FATAL_ERROR "Core-only install verification failed: ${OVSPATIALQUERY_VERIFY_RESULT}")
endif()

# Transferred fixtures must remain unchanged. An incompatible cached generator
# should fail configure, never delete or rebuild the producer's executables.
if(NOT OVSPATIALQUERY_PREBUILT_CORE_INDEPENDENCE)
    ovspatialquery_prepare_nested_build("${OVSPATIALQUERY_CONSUMER_BUILD}"
        "${OVSPATIALQUERY_GENERATOR}")
endif()
execute_process(
    COMMAND "${CMAKE_COMMAND}"
        -S "${OVSPATIALQUERY_SOURCE_DIR}/tests/integration/installed/core_independence_consumer"
        -B "${OVSPATIALQUERY_CONSUMER_BUILD}"
        ${OVSPATIALQUERY_GENERATOR_ARGS}
        "-DCMAKE_BUILD_TYPE=${OVSPATIALQUERY_BUILD_CONFIG}"
        "-DCMAKE_C_FLAGS=${OVSPATIALQUERY_C_FLAGS}"
        "-DCMAKE_CXX_FLAGS=${OVSPATIALQUERY_CXX_FLAGS}"
        "-DCMAKE_C_FLAGS_${OVSPATIALQUERY_BUILD_CONFIG_UPPER}=${OVSPATIALQUERY_C_FLAGS_CONFIG}"
        "-DCMAKE_CXX_FLAGS_${OVSPATIALQUERY_BUILD_CONFIG_UPPER}=${OVSPATIALQUERY_CXX_FLAGS_CONFIG}"
        "-DOVSPATIALQUERY_INSTALL_ROOT=${OVSPATIALQUERY_CORE_INSTALL}"
        "-DPython3_EXECUTABLE=${OVSPATIALQUERY_PYTHON_EXECUTABLE}"
    RESULT_VARIABLE OVSPATIALQUERY_CONSUMER_CONFIGURE_RESULT)
if(NOT OVSPATIALQUERY_CONSUMER_CONFIGURE_RESULT EQUAL 0)
    message(FATAL_ERROR
        "Core-only consumer configure failed: ${OVSPATIALQUERY_CONSUMER_CONFIGURE_RESULT}")
endif()
if(NOT OVSPATIALQUERY_PREBUILT_CORE_INDEPENDENCE)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" --build "${OVSPATIALQUERY_CONSUMER_BUILD}"
            --config "${OVSPATIALQUERY_BUILD_CONFIG}"
        RESULT_VARIABLE OVSPATIALQUERY_CONSUMER_BUILD_RESULT)
    if(NOT OVSPATIALQUERY_CONSUMER_BUILD_RESULT EQUAL 0)
        message(FATAL_ERROR
            "Core-only consumer build failed: ${OVSPATIALQUERY_CONSUMER_BUILD_RESULT}")
    endif()

endif()

execute_process(
    COMMAND "${OVSPATIALQUERY_CTEST_COMMAND}"
        --test-dir "${OVSPATIALQUERY_CONSUMER_BUILD}"
        -C "${OVSPATIALQUERY_BUILD_CONFIG}"
        --interactive-debug-mode 0 --output-on-failure
    RESULT_VARIABLE OVSPATIALQUERY_CONSUMER_RUN_RESULT)
if(NOT OVSPATIALQUERY_CONSUMER_RUN_RESULT EQUAL 0)
    message(FATAL_ERROR
        "Core-only installed consumers failed: ${OVSPATIALQUERY_CONSUMER_RUN_RESULT}")
endif()

message(STATUS "Core-only install, C/C++ consumers and compiled ctypes witness passed")
