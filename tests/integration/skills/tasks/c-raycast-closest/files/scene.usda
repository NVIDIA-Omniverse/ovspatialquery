#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Obstacles"
    {
        def Cube "Crate"
        {
            double size = 2
            float3[] extent = [(-1, -1, -1), (1, 1, 1)]
            double3 xformOp:translate = (5, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Ball"
        {
            double radius = 1.5
            float3[] extent = [(-1.5, -1.5, -1.5), (1.5, 1.5, 1.5)]
            double3 xformOp:translate = (0, 8, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "Shelf"
        {
            double3 xformOp:translate = (-10, 0, 0)
            float3 xformOp:scale = (2, 2, 2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

            def Cube "Board"
            {
                double size = 1
                float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
                double3 xformOp:translate = (1, 0, 0.25)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def Cube "Pillar"
        {
            double size = 2
            float3[] extent = [(-1, -1, -1), (1, 1, 1)]
            double3 xformOp:translate = (0, -6, 1)
            float xformOp:rotateZ = 45
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
    }

    def Xform "Decor"
    {
        def Sphere "Lamp"
        {
            double radius = 0.5
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            double3 xformOp:translate = (2.5, 0, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Cube "Floor"
    {
        double size = 1
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double3 xformOp:translate = (0, 0, -0.5)
        float3 xformOp:scale = (100, 100, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
